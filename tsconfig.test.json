{
  "//": "Compiles the pure modules (no React, no native) to CommonJS so node --test can run them.",
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/engine/**/*.ts", "src/content/**/*.ts", "test/**/*.ts"]
}

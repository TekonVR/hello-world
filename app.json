{
  "expo": {
    "name": "Lock In",
    "slug": "lock-in",
    "scheme": "lockin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0F14",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "co.uk.tekon.lockin" },
    "android": {
      "package": "uk.co.tekon.lockin",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": { "backgroundColor": "#0C0F14" }
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
